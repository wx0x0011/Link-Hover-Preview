{
  "manifest_version": 3,
  "name": "Link Hover Preview",
  "version": "0.3.0",
  "description": "Preview links with VirusTotal results and offline BrandGuard domain lookalike warnings",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Link Hover Preview",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "brand-guard.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
